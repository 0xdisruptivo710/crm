{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"] },
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^typecheck"] },
    // serializa testes ao longo do grafo de dependências — os testes de db (que fazem
    // wipe) terminam antes dos da api (que criam fixtures) no mesmo banco remoto.
    // "env": modo estrito do turbo filtra vars não declaradas — no CI elas vêm do
    // ambiente do job (não do arquivo .env) e seriam descartadas sem esta lista.
    // Bônus: entram na chave de cache — mudou o ambiente, invalida o PASS cacheado.
    "test": {
      "dependsOn": ["^test"],
      "env": ["DATABASE_URL", "REDIS_URL", "SUPABASE_URL", "APP_ENCRYPTION_KEY"]
    }
  }
}
