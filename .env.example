# Copie para .env e preencha. NUNCA commitar o .env real.

# --- Supabase ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Banco (Prisma) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/aios_pocket
SUPABASE_DATABASE_URL=
# banco VIVO do piloto — usado pelo seed/admin (packages/db/prisma/seed.ts); testes usam
# DATABASE_URL, que DEVE apontar para aios-pocket-test (nunca para o banco vivo)
LIVE_DATABASE_URL=

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Evolution API ---
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_ID=

# --- Evolution dedicada de dev (projeto aios-pocket no EasyPanel) ---
EVOLUTION_DEV_BASE_URL=
EVOLUTION_DEV_API_KEY=
EVOLUTION_DEV_INSTANCE=
EVOLUTION_DEV_SELF_PHONE=

# --- Z-API ---
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Aplicação ---
APP_ENCRYPTION_KEY= # 32 bytes em base64
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
PORT=3001

# --- apps/web (Next.js) ---
# Next.js só lê apps/web/.env.local (não este arquivo/raiz) — copie os
# valores públicos (URL + anon key) para lá. NUNCA colocar service_role
# aqui nem em apps/web/.env.local (ADR-0001).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
